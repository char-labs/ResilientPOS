// 수집 방식은 docs/wiki/observability.md의 "LGTM을 붙일 때"를 따른다.

// metric: 앱의 Prometheus 엔드포인트를 scrape해 lgtm의 Prometheus로 remote_write한다.
prometheus.scrape "app" {
  targets         = [{"__address__" = "app:8080"}]
  metrics_path    = "/actuator/prometheus"
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.lgtm.receiver]
}

// synthetic probe: health(DB 포함)를 15초마다 불러 probe_success를 같은 경로로 넣는다. 2xx만 성공이다.
// HealthProbeFailing 규칙이 application label로 고르므로 앱 metric과 같은 값을 붙인다.
prometheus.exporter.blackbox "health" {
  config = "{ modules: { http_2xx: { prober: http } } }"
  target {
    name    = "app-health"
    address = "http://app:8080/actuator/health"
    module  = "http_2xx"
  }
}

discovery.relabel "health" {
  targets = prometheus.exporter.blackbox.health.targets
  rule {
    target_label = "application"
    replacement  = "ResilientPOS"
  }
}

prometheus.scrape "health" {
  targets         = discovery.relabel.health.output
  scrape_interval = "15s"
  forward_to      = [prometheus.remote_write.lgtm.receiver]
}

prometheus.remote_write "lgtm" {
  endpoint {
    url = "http://lgtm:9090/api/v1/write"
  }
}

// 로그: 이 compose 프로젝트의 app 컨테이너 stdout만 읽는다.
discovery.docker "app" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=resilientpos", "com.docker.compose.service=app"]
  }
}

loki.source.docker "app" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.app.targets
  forward_to = [loki.process.ecs.receiver]
}

// ECS 필드 service.name·log.level만 label로 올린다. 값이 많은 필드는 쿼리에서 | json으로 거른다.
// traceId는 줄마다 달라 label이 아니라 structured metadata trace_id로 둔다. Grafana의 trace↔로그 링크가 이 이름을 쓴다.
loki.process "ecs" {
  stage.json {
    expressions = {
      service_name = "service.name",
      level        = "log.level",
      trace_id     = "traceId",
    }
  }
  stage.labels {
    values = {
      service_name = "",
      level        = "",
    }
  }
  stage.structured_metadata {
    values = {
      trace_id = "",
    }
  }
  forward_to = [loki.write.lgtm.receiver]
}

loki.write "lgtm" {
  endpoint {
    url = "http://lgtm:3100/loki/api/v1/push"
  }
}

// trace: 앱이 OTLP HTTP로 보낸 span을 묶어 lgtm의 Tempo(OTLP gRPC)로 넘긴다.
otelcol.receiver.otlp "app" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.lgtm.input]
  }
}

otelcol.exporter.otlp "lgtm" {
  client {
    endpoint = "lgtm:4317"
    tls {
      insecure = true
    }
  }
}
