{
  "realm": "resilientpos",
  "enabled": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "OPERATOR", "description": "모든 매장의 단말을 관리하는 운영자" }
    ]
  },
  "clients": [
    {
      "clientId": "resilientpos-admin-cli",
      "name": "로컬 운영자 토큰 발급용",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "resilientpos-admin",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "operator",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Operator",
      "email": "operator@resilientpos.local",
      "credentials": [{ "type": "password", "value": "operator", "temporary": false }],
      "realmRoles": ["default-roles-resilientpos", "OPERATOR"]
    },
    {
      "username": "viewer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Viewer",
      "email": "viewer@resilientpos.local",
      "credentials": [{ "type": "password", "value": "viewer", "temporary": false }],
      "realmRoles": ["default-roles-resilientpos"]
    }
  ]
}
